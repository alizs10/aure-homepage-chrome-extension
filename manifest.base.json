{
  "manifest_version": 3,
  "name": "Aure Homepage",
  "version": "0.2.0",
  "description": "Custom New Tab",
  "permissions": ["storage", "topSites", "notifications", "alarms", "history"],
  "optional_host_permissions": [
    "https://suggestqueries.google.com/*",
    "https://duckduckgo.com/*",
    "https://*.duckduckgo.com/*",
    "https://search.brave.com/*",
    "https://api.bing.com/*",
    "https://*.bing.com/*",
    "https://suggest.yandex.com/*",
    "https://*.yandex.com/*",
    "https://gerdoo.me/*",
    "https://*.gerdoo.me/*",
    "https://*.gstatic.com/*",
    "https://raw.githubusercontent.com/*",
    "https://*.geojs.io/*",
    "https://ipwho.is/*",
    "https://flagcdn.com/*"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
